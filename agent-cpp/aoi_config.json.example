{
  // knowledgeBase: 私人知识库路径，内容不入库（可选；留空 = 不注入）。
  // UTF-8 文件，每行 "词 | 简短解释"（竖线分隔）；文件存在且非空时注入 system prompt。
  "knowledgeBase": "",
  "llm": {
    "baseUrl": "https://opencode.ai/zen/go/v1",
    "apiKey": "",
    "model": "mimo-v2.5",
    "thinking": "disabled",
    "reasoningEffort": "low",
    // nativeAudio: 是否把你的原始语音直接发给大模型"亲耳听"。
    //   true（默认）= 原始语音作为 input_audio 内容块发送（保留语气/情绪，
    //                与上游行为一致）。需要支持音频输入的端点，
    //                如 MiMo API 直连 https://api.xiaomimimo.com/v1 + mimo-v2.5。
    //   false       = 先发给下方 asr 端点转写，再只把文字交给这里的 LLM。
    //                任何 OpenAI 兼容的纯文本端点都能用（如 opencode zen/go）。
    // 若端点返回 400 且报错提到 input_audio，后续轮次会自动降级为远程 ASR。
    "nativeAudio": true
  },
  // Optional remote ASR stage used when llm.nativeAudio is false, or after a
  // native-audio endpoint rejects input_audio. If apiKey is empty, the loader
  // falls back to tts.apiKey first, then llm.apiKey.
  "asr": {
    "baseUrl": "https://api.xiaomimimo.com/v1",
    "apiKey": "",
    "model": "mimo-v2.5"
  },
  "tts": {
    "enabled": true,
    "baseUrl": "https://api.xiaomimimo.com/v1",
    "apiKey": "",
    "model": "mimo-v2.5-tts",
    "voice": "冰糖"
  }
}
