{
  // knowledgeBase: 私人知识库路径，内容不入库（可选；留空 = 不注入）。
  // UTF-8 文件，每行四列：中文 | English | 日本語 | 中文解释；# 开头为注释。
  "knowledgeBase": "",
  "llm": {
    "baseUrl": "https://opencode.ai/zen/go/v1",
    "apiKey": "",
    "model": "mimo-v2.5",
    "thinking": "disabled",
    "reasoningEffort": "low",
    // nativeAudio=true 保持上游原生 input_audio；false 先走远程 ASR，再把纯文字交给 LLM。
    "nativeAudio": true,
    // 默认 false；true 时在程序重启后加载 exe 旁的 history.json。
    "persistHistory": false
  },
  // 当 nativeAudio=false，或原生端点拒绝 input_audio 时使用的独立 ASR 端点。
  // apiKey 留空时，仅在 ASR 与 TTS/LLM 的规范化 origin 相同的情况下回退。
  "asr": {
    "baseUrl": "https://api.xiaomimimo.com/v1",
    "apiKey": "",
    "model": "mimo-v2.5"
  },
  "tts": {
    "enabled": true,
    "baseUrl": "https://api.xiaomimimo.com/v1",
    "apiKey": "",
    "model": "mimo-v2.5-tts",
    "voice": "冰糖"
  },
  // 留空时使用 %APPDATA%\\VRCX\\VRCX.sqlite3。
  "vrcxDbPath": "",
  // 允许 sandbox 用户读取的 exe 相对目录；不要把 aoi_config.json 所在目录加入其中。
  "sandbox": {
    "read_dirs": ["docs"]
  },
  // Hooks remain disabled for the first integration acceptance; enabling them
  // is an explicit runtime decision because hooks may cause background LLM calls.
  "hooks": {
    "enabled": false,
    "maxHooks": 10,
    "dailyBudget": 100,
    "silentHours": {"start": 0, "end": 8},
    "scriptTimeoutSeconds": 30,
    "scriptOutputLimitBytes": 102400
  }
}
